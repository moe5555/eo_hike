+#----------------------------------------------------------------------------
+# eo_hike g1 patch: a seeded weighted sampler (notes/brief_gan_g1.md). Draws dataset indices with probability proportional to their
+# weight, with replacement, forever. Both G1 runs use it (G1-null with every weight 1), so both go through the same code path.
+# The stream is seeded by (seed, start_nimg): a resumed run draws a new, reproducible stream from where it resumed.
+
+class WeightedInfiniteSampler(torch.utils.data.Sampler):
+    def __init__(self, weights, seed=0, start_nimg=0, block=8192):
+        super().__init__()
+        w = np.asarray(weights, dtype=np.float64)
+        assert w.ndim == 1 and len(w) > 0 and np.all(np.isfinite(w)) and np.all(w > 0)
+        self.p = w / w.sum()
+        self.seed = int(seed)
+        self.start_nimg = int(start_nimg)
+        self.block = int(block)
+
+    def __iter__(self):
+        rng = np.random.default_rng([self.seed, self.start_nimg])
+        while True:
+            for i in rng.choice(len(self.p), size=self.block, replace=True, p=self.p):
+                yield int(i)
+
